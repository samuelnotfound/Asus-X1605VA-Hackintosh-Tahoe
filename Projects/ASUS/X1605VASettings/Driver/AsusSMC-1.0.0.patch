+#!/bin/bash
+set -euo pipefail
+cd "$(dirname "$0")"
+TASK_ROOT="$PWD"
+RELEASE_VERSION=$(tr -d '\r\n' < VERSION)
+[[ "$RELEASE_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "Invalid VERSION" >&2; exit 1; }
+BUILD_DIR="$TASK_ROOT/build-x1605va"
+DEPS_DIR="${X1605VA_DEPS:-$TASK_ROOT/.deps}"
+mkdir -p "$DEPS_DIR" "$BUILD_DIR/obj" "$BUILD_DIR/AsusSMC.kext/Contents/MacOS"
