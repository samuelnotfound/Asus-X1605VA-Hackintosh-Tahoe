diff --git a/AsusSMC/X1605VAProtocol.hpp b/AsusSMC/X1605VAProtocol.hpp
new file mode 100644
index 0000000..a24d5d6
--- /dev/null
+++ b/AsusSMC/X1605VAProtocol.hpp
@@ -0,0 +1,22 @@
+// X1605VA BIOS 305 protocol helpers. Copyright (c) 2026 samuelnotfound.
+// MIT License; see LICENSE.md.
+#pragma once
+#include <stdint.h>
+
+namespace X1605VA {
+static constexpr uint32_t ControlAPIVersion = 1;
+inline bool decodeRPM(uint32_t raw, uint16_t &rpm) {
+    if (raw == UINT32_MAX || raw == UINT32_MAX - 1 || !(raw & 0x10000U)) return false;
+    const uint32_t value = (raw & 0xffffU) * 100U;
+    if (value > 16383U) return false; // SMC fpe2 cannot represent larger RPM.
+    rpm = static_cast<uint16_t>(value);
+    return true;
+}
+inline bool decodeProfile(uint32_t raw, uint32_t &profile) {
+    if (raw == UINT32_MAX || raw == UINT32_MAX - 1 || !(raw & 0x10000U)) return false;
+    const uint32_t value = raw & 0xffU;
+    if (value > 2) return false;
+    profile = value;
+    return true;
+}
+}
diff --git a/Tests/protocol.cpp b/Tests/protocol.cpp
new file mode 100644
index 0000000..a362454
--- /dev/null
+++ b/Tests/protocol.cpp
@@ -0,0 +1,21 @@
+#include "../AsusSMC/X1605VAProtocol.hpp"
+#include <cassert>
+#include <cstdio>
+int main() {
+    uint16_t rpm = 1234;
+    assert(!X1605VA::decodeRPM(0xfffffffeU, rpm) && rpm == 1234);
+    assert(!X1605VA::decodeRPM(0xffffffffU, rpm));
+    assert(!X1605VA::decodeRPM(0, rpm));
+    assert(X1605VA::decodeRPM(0x10000, rpm) && rpm == 0);
+    assert(X1605VA::decodeRPM(0x1000f, rpm) && rpm == 1500);
+    assert(X1605VA::decodeRPM(0x1003a, rpm) && rpm == 5800);
+    assert(X1605VA::decodeRPM(0x100a3, rpm) && rpm == 16300);
+    assert(!X1605VA::decodeRPM(0x100a4, rpm) && rpm == 16300);
+    uint32_t profile = 99;
+    for (uint32_t value = 0; value < 3; ++value)
+        assert(X1605VA::decodeProfile(0x03030000U | value, profile) && profile == value);
+    assert(!X1605VA::decodeProfile(0xfffffffeU, profile));
+    assert(!X1605VA::decodeProfile(0x03030003U, profile));
+    assert(!X1605VA::decodeProfile(1, profile));
+    puts("PASS: RPM decoding, stopped fan, fpe2 limits, unsupported sentinels, and Vivobook profiles.");
+}
