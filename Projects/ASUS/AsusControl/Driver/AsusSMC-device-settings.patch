+// ASUS Control protocol helpers. Copyright (c) 2026 samuelnotfound.
+// MIT License; see LICENSE.md.
+#pragma once
+#include <stdint.h>
+
+namespace AsusControl {
+static constexpr uint32_t ControlAPIVersion = 2;
+inline bool decodeFnLock(uint32_t raw, bool &hotkeys) {
+    if (raw != 0x10000U && raw != 0x10001U) return false;
+    hotkeys = (raw & 1U) != 0;
+    return true;
+}
+inline bool devicePresent(uint32_t raw) {
+    return raw != UINT32_MAX && raw != UINT32_MAX - 1 && (raw & 0x10000U);
+}
+inline bool validDeviceCommand(uint64_t command) { return command >= 1 && command <= 11; }
+inline bool decodeRPM(uint32_t raw, uint16_t &rpm) {
+    if (raw == UINT32_MAX || raw == UINT32_MAX - 1 || !(raw & 0x10000U)) return false;
+    const uint32_t value = (raw & 0xffffU) * 100U;
+    if (value > 16383U) return false; // SMC fpe2 cannot represent larger RPM.
+    rpm = static_cast<uint16_t>(value);
+    return true;
+}
+inline bool decodeProfile(uint32_t raw, uint32_t &profile) {
+    if (raw == UINT32_MAX || raw == UINT32_MAX - 1 || !(raw & 0x10000U)) return false;
+    const uint32_t value = raw & 0xffU;
+    if (value > 2) return false;
+    profile = value;
+    return true;
+}
+}
