+++ b/AsusSMC/Models/X1605VA305.hpp
@@ -0,0 +1,51 @@
+// Confirmed firmware wiring for ASUS X1605VA BIOS 305. MIT License.
+#pragma once
+#include <stdint.h>
+#include <stddef.h>
+namespace AsusControl {
+struct HardwareProfile {
+    const char *identifier;
+    const char *label;
+    uint32_t fan, thermal, chargeLimit, fnLock;
+    bool performanceOnBattery;
+    uint32_t performanceMinimumBattery;
+};
+static constexpr HardwareProfile X1605VA305 {
+    "x1605va305", "ASUS X1605VA / BIOS 305", 0x00110013,
+    0x00110019, 0x00120057, 0x00100023, false, 40
+};
+// Match the cached firmware's actual method wiring, not a spoofed Mac SMBIOS.
+// These short AML sequences describe the known fan/thermal/Fn implementations.
+static constexpr uint8_t FanReadWiring[] = {
+    0x0c,0x13,0x00,0x11,0x00,0x70,0x5e,0x5e,0x2f,0x04,0x50,0x43,0x30,0x30,
+    0x4c,0x50,0x43,0x42,0x45,0x43,0x30,0x5f,0x52,0x54,0x41,0x48,0x00,0x60,
+    0x78,0x60,0x0a,0x64,0x00,0x60,0xa4,0x72,0x0c,0x00,0x00,0x01,0x00,0x60,0x00
+};
+static constexpr uint8_t ThermalWriteWiring[] = {
+    0x0c,0x19,0x00,0x11,0x00,0x46,0x41,0x4e,0x4c,0x49,0x49,0x41,0x31,0xa4,0x01
+};
+static constexpr uint8_t FnReadWiring[] = {
+    0x0c,0x23,0x00,0x10,0x00,0x70,0x0c,0x00,0x00,0x01,0x00,0x60,0xa0,0x0c,
+    0x93,0x4b,0x46,0x53,0x4b,0x0a,0x80,0x7d,0x01,0x60,0x60,0xa4,0x60
+};
+inline bool containsWiring(const uint8_t *data, size_t size, const uint8_t *pattern, size_t length) {
+    if (!data || size < length) return false;
+    for (size_t i=0;i<=size-length;++i) {
+        size_t j=0; while(j<length && data[i+j]==pattern[j]) ++j;
+        if(j==length) return true;
+    }
+    return false;
+}
+inline bool matchesFirmware(const uint8_t *data, size_t size) {
+    if (!data || size<36) return false;
+    const uint8_t signature[]={'D','S','D','T'}, oem[]={'_','A','S','U','S','_'};
+    for(size_t i=0;i<4;++i) if(data[i]!=signature[i]) return false;
+    for(size_t i=0;i<6;++i) if(data[10+i]!=oem[i]) return false;
+    uint32_t length=(uint32_t)data[4]|((uint32_t)data[5]<<8)|((uint32_t)data[6]<<16)|((uint32_t)data[7]<<24);
+    if(length<36 || length>size) return false;
+    return containsWiring(data,length,FanReadWiring,sizeof(FanReadWiring)) &&
+        containsWiring(data,length,ThermalWriteWiring,sizeof(ThermalWriteWiring)) &&
+        containsWiring(data,length,FnReadWiring,sizeof(FnReadWiring));
+}
+
+}
