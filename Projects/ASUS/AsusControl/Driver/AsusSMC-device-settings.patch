+// The property handler only enqueues; firmware calls happen on the existing
+// sensor workloop, serialized with polling, outside the client's property call.
+IOReturn AsusSMC::setProperties(OSObject *properties) {
+    auto dict = OSDynamicCast(OSDictionary, properties);
+    if (!dict || dict->getCount() != 2) return kIOReturnBadArgument;
+    if (!atomic_load_explicit(&fanControlReady, memory_order_acquire)) return kIOReturnNotReady;
+    const bool keyboard = dict->getObject("KeyboardPercent") != nullptr;
+    const bool refresh = dict->getObject("SettingsCommand") != nullptr;
+    const bool device = dict->getObject("DeviceCommand") != nullptr;
+    const bool administrator = IOUserClient::clientHasPrivilege(current_task(), kIOClientPrivilegeAdministrator) == kIOReturnSuccess;
+    if (!administrator && ((!keyboard && !refresh && !device) || IOUserClient::clientHasPrivilege(current_task(), kIOClientPrivilegeLocalUser) != kIOReturnSuccess))
+        return kIOReturnNotPrivileged;
+    if (device ? !deviceControlAllowed : refresh ? !asusControlEnabled : keyboard ? !keyboardDevice : !fanControlAllowed) return kIOReturnNotReady;
+    auto cmd = OSDynamicCast(OSNumber, dict->getObject(device ? "DeviceCommand" : refresh ? "SettingsCommand" : keyboard ? "KeyboardPercent" : "FanCommand"));
+    auto id = OSDynamicCast(OSNumber, dict->getObject(device ? "DeviceRequestID" : refresh ? "SettingsRequestID" : keyboard ? "KeyboardRequestID" : "FanRequestID"));
+    if (!cmd || !id || (device ? !AsusControl::validDeviceCommand(cmd->unsigned64BitValue()) : refresh ? cmd->unsigned64BitValue() != 1 : keyboard ? cmd->unsigned64BitValue() > 100 :
+        (cmd->unsigned64BitValue() < 1 || cmd->unsigned64BitValue() > 5)) ||
+        id->unsigned64BitValue() == 0 || id->unsigned64BitValue() > UINT32_MAX)
+        return kIOReturnBadArgument;
+    uint64_t expected = 0;
+    const uint32_t operation = device ? 0x300U + cmd->unsigned32BitValue() : refresh ? 0x200U : keyboard ? 0x100U + cmd->unsigned32BitValue() : cmd->unsigned32BitValue();
+    const uint64_t request = (id->unsigned64BitValue() << 32) | operation;
+    if (!atomic_compare_exchange_strong_explicit(&pendingFanCommand, &expected, request,
+                                                memory_order_release, memory_order_relaxed))
+        return kIOReturnBusy;
+    // Wake the existing workloop timer for an accepted explicit request.
+    // ACPI still runs only on that workloop, never in this property handler.
+    // Keep the normal one-second interval for passive sensor monitoring.
+    if (poller) poller->setTimeoutMS(0);
+    return kIOReturnSuccess;
+}
+
+void AsusSMC::processFanCommand() {
+    if (!atomic_load_explicit(&fanControlReady, memory_order_acquire)) return;
+    const uint64_t request = atomic_load_explicit(&pendingFanCommand, memory_order_acquire);
+    if (!request) return;
+    const uint32_t cmd = static_cast<uint32_t>(request);
+    const uint32_t id = static_cast<uint32_t>(request >> 32);
+    if (cmd >= 0x301U && cmd <= 0x30bU) {
+        const bool success = processDeviceCommand(cmd - 0x300U);
+        setProperty("DeviceCommandSucceeded", success);
+        setProperty("DeviceCompletedRequestID", id, 32);
+        atomic_store_explicit(&pendingFanCommand, 0, memory_order_release);
+        return;
+    }
+    if (cmd == 0x200U) {
+        if (!keyboardDevice) initKeyboardDevice();
+        refreshDeviceSettings();
+        setProperty("SettingsCommandSucceeded", true);
+        setProperty("SettingsCompletedRequestID", id, 32);
+        atomic_store_explicit(&pendingFanCommand, 0, memory_order_release);
+        return;
+    }
+    if (cmd >= 0x100U && cmd <= 0x164U) {
+        const uint32_t percent = cmd - 0x100U;
+        auto arg = OSNumber::withNumber(percent, 32);
+        uint32_t result = 0xff;
+        IOReturn ret = kIOReturnNoMemory;
+        if (arg && keyboardDevice) {
+            OSObject *args[] = {arg};
+            ret = keyboardDevice->evaluateInteger("SKPC", &result, args, 1);
+        }
+        OSSafeReleaseNULL(arg);
+        const bool success = ret == kIOReturnSuccess && result == percent;
+        setProperty("KeyboardCommandSucceeded", success);
+        setProperty("KeyboardCommandReply", static_cast<uint64_t>(ret), 32);
+        setProperty("KeyboardCompletedRequestID", id, 32);
+        atomic_store_explicit(&pendingFanCommand, 0, memory_order_release);
+        return;
+    }
+    // 1=automatic, 2=full speed; 3=standard, 4=whisper, 5=performance.
+    // Vivobook profile numbering is different from ROG.
+    const uint32_t device = cmd <= 2 ? ASUS_WMI_DEVID_CPU_FAN_CTRL : 0x00110019;
+    const uint32_t value = cmd <= 2 ? cmd - 1 : cmd - 3;
+    SYSLOG("fan", "request %u: DEVS device %x value %u", id, device, value);
+    const int reply = wmi_evaluate_method(ASUS_WMI_METHODID_DEVS, device, value);
+    setProperty("FanCommandReply", static_cast<uint64_t>(static_cast<uint32_t>(reply)), 32);
+    setProperty("FanCommandSucceeded", reply == 1);
+    if (reply == 1 && cmd <= 2) setProperty("FanRequestedMode", cmd - 1, 32);
+    // Publish completion ID last, after the reply. This is an acknowledgement,
+    // not physical verification of the resulting fan mode.
+    setProperty("FanCompletedRequestID", static_cast<uint64_t>(id), 32);
+    SYSLOG("fan", "request %u: reply %x", id, reply);
+    atomic_store_explicit(&pendingFanCommand, 0, memory_order_release);
+}
+
+// Use the existing percentage-backlight SSDT interface; do not guess EC offsets
+// or install/rename ACPI objects. Discovery never writes to the firmware.
+void AsusSMC::initKeyboardDevice() {
+    auto dict = IOService::nameMatching("PNP0C09");
+    auto iterator = dict ? IOService::getMatchingServices(dict) : nullptr;
+    OSSafeReleaseNULL(dict);
+    if (iterator) {
+        while (auto entry = iterator->getNextObject()) {
+            auto device = OSDynamicCast(IOACPIPlatformDevice, entry);
+            if (device && device->validateObject("GKPC") == kIOReturnSuccess &&
+                device->validateObject("SKPC") == kIOReturnSuccess) {
+                keyboardDevice = device;
+                keyboardDevice->retain();
+                break;
+            }
+        }
+        iterator->release();
+    }
+    setProperty("KeyboardControlAvailable", keyboardDevice != nullptr);
+}
+
+void AsusSMC::refreshDeviceSettings() {
+    if (!asusControlEnabled) return;
+    const int raw = wmi_get_devstate(0x00110019);
+    uint32_t profile = 0;
+    const bool valid = AsusControl::decodeProfile(static_cast<uint32_t>(raw), profile);
+    setProperty("ThermalProfileValid", valid);
+    if (valid) setProperty("ThermalProfile", profile, 32);
+    uint32_t percent = 0xff;
+    const bool keyboardValid = keyboardDevice &&
+        keyboardDevice->evaluateInteger("GKPC", &percent) == kIOReturnSuccess && percent <= 100;
+    setProperty("KeyboardReadingValid", keyboardValid);
+    if (keyboardValid) setProperty("KeyboardPercent", percent, 32);
+    const uint32_t charge = static_cast<uint32_t>(wmi_get_devstate(AsusControl::X1605VA305.chargeLimit));
+    chargeLimitAvailable = AsusControl::devicePresent(charge);
+    setProperty("BatteryCareAvailable", chargeLimitAvailable);
+    bool hotkeys = false;
+    const uint32_t fnRaw = static_cast<uint32_t>(wmi_get_devstate(AsusControl::X1605VA305.fnLock));
+    setProperty("FnLockRaw", fnRaw, 32);
+    fnLockAvailable = AsusControl::decodeFnLock(fnRaw, hotkeys);
+    setProperty("FnLockAvailable", fnLockAvailable);
+    if (fnLockAvailable) setProperty("FnLockHotkeys", hotkeys);
+    bool trackpad = false;
+    const bool trackpadValid = readTrackpad(&trackpad);
+    setProperty("TrackpadReadingValid", trackpadValid);
+    setProperty("TrackpadControlAvailable", trackpadValid && atkDevice->validateObject("IANE") == kIOReturnSuccess);
+    if (trackpadValid) setProperty("TrackpadEnabled", trackpad);
+    settingsInitialized = true;
+}
+
+// Match the built-in touchpad only, never a touchscreen or external mouse.
+bool AsusSMC::readTrackpad(bool *enabled) {
+    auto matching = IOService::serviceMatching("VoodooI2CMultitouchHIDEventDriver");
+    auto iterator = matching ? IOService::getMatchingServices(matching) : nullptr;
+    OSSafeReleaseNULL(matching);
+    if (!iterator) return false;
+    IOService *target = nullptr;
+    bool ambiguous = false;
+    while (auto entry = iterator->getNextObject()) {
+        auto candidate = OSDynamicCast(IOService, entry);
+        if (!candidate || candidate->isInactive()) continue;
+        const char *name = candidate->getMetaClass()->getClassName();
+        if (strcmp(name, "VoodooI2CPrecisionTouchpadHIDEventDriver") && strcmp(name, "VoodooI2CMultitouchHIDEventDriver")) continue;
+        if (target) { ambiguous = true; break; }
+        target = candidate;
+    }
+    const bool valid = !ambiguous && target && target->message(kKeyboardGetTouchStatus, this, enabled) == kIOReturnSuccess;
+    iterator->release();
+    return valid;
+}
+
+bool AsusSMC::processDeviceCommand(uint32_t command) {
+    if (!deviceControlAllowed || !AsusControl::validDeviceCommand(command)) return false;
+    if (!settingsInitialized) {
+        if (!keyboardDevice) initKeyboardDevice();
+        refreshDeviceSettings();
+    }
+    if (command <= 2) {
+        if (!chargeLimitAvailable) return false;
+        const uint32_t limit = command == 1 ? 80 : 100;
+        if (wmi_evaluate_method(ASUS_WMI_METHODID_DEVS, AsusControl::X1605VA305.chargeLimit, limit) != 1) return false;
+        setProperty("ChargeLimitRequested", limit, 32);
+        setProperty("BatteryConservativeMode", command == 1);
+        return true;
+    }
+    if (command <= 4) {
+        if (!fnLockAvailable) return false;
+        const bool acknowledged = wmi_evaluate_method(ASUS_WMI_METHODID_DEVS, AsusControl::X1605VA305.fnLock, command == 3 ? 1 : 0) == 1;
+        setProperty("FnLockWriteAcknowledged", acknowledged);
+        if (acknowledged) setProperty("FnLockRequestedHotkeys", command == 3);
+        return acknowledged;
+    }
+    if (command <= 6) {
+        bool enabled = false;
+        if (!readTrackpad(&enabled)) return false;
+        if (enabled == (command == 5)) return true;
+        auto arg = OSNumber::withNumber(0x6b, 32);
+        if (!arg) return false;
+        OSObject *args[] = {arg};
+        const IOReturn ret = atkDevice->evaluateObject("IANE", nullptr, args, 1);
+        arg->release();
+        return ret == kIOReturnSuccess; // Notification acknowledgement; readback confirms state later.
+    }
+    if (command >= 10) {
+        const uint32_t mode = command == 10 ? 1 : 0;
+        const int reply = wmi_evaluate_method(ASUS_WMI_METHODID_DEVS, AsusControl::X1605VA305.fan, mode);
+        if (reply == 1) setProperty("FanRequestedMode", mode, 32);
+        return reply == 1;
+    }
+    if (wmi_evaluate_method(ASUS_WMI_METHODID_DEVS, AsusControl::X1605VA305.fan, 0) != 1) return false;
+    setProperty("FanRequestedMode", static_cast<uint64_t>(0), 32);
+    return wmi_evaluate_method(ASUS_WMI_METHODID_DEVS, AsusControl::X1605VA305.thermal, command - 7) == 1;
+}
